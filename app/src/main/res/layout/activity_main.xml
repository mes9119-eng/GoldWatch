<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:layoutDirection="rtl">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:gravity="top">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="مراقب الذهب"
                    android:textColor="@color/gold"
                    android:textSize="28sp"
                    android:textStyle="bold" />
                <TextView style="@style/Label"
                    android:text="سعر الجرام بالريال السعودي" />
            </LinearLayout>

            <!-- dedication badge (gift edition only) -->
            <LinearLayout
                android:id="@+id/dedication"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/badge_bg"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="6dp"
                android:paddingBottom="8dp"
                android:visibility="gone">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✦ نسخة خاصة ✦"
                    android:textColor="@color/muted"
                    android:textSize="11sp" />
                <TextView
                    android:id="@+id/dedicationName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/gold_light"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- prices -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="vertical"
            android:background="@drawable/hero_bg"
            android:padding="20dp">
            <TextView android:id="@+id/lMain" style="@style/Label" android:text="عيار 24" />
            <TextView android:id="@+id/pMain"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="--" android:textColor="@color/gold_light"
                android:textSize="44sp" android:textStyle="bold" />
            <TextView android:id="@+id/change"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="@color/muted" android:textSize="13sp" />

            <!-- world + bank prices side by side (shown when a bank margin is set) -->
            <LinearLayout android:id="@+id/bankRow"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="14dp" android:orientation="horizontal"
                android:background="@drawable/input_bg" android:padding="12dp"
                android:visibility="gone">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                    <TextView style="@style/Label" android:text="بيع للبنك" android:textSize="11sp" />
                    <TextView android:id="@+id/pSell" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="--"
                        android:textColor="#FF8A80" android:textSize="17sp" android:textStyle="bold" />
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                    <TextView style="@style/Label" android:text="العالمي" android:textSize="11sp" />
                    <TextView android:id="@+id/pWorld" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="--"
                        android:textColor="@color/text" android:textSize="17sp" android:textStyle="bold" />
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                    <TextView style="@style/Label" android:text="شراء من البنك" android:textSize="11sp" />
                    <TextView android:id="@+id/pBuy" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="--"
                        android:textColor="#80E0A0" android:textSize="17sp" android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="16dp" android:orientation="horizontal">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView android:id="@+id/lA" style="@style/Label" android:text="عيار 21" />
                    <TextView android:id="@+id/pA" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="--"
                        android:textColor="@color/text" android:textSize="22sp" android:textStyle="bold" />
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView android:id="@+id/lB" style="@style/Label" android:text="عيار 18" />
                    <TextView android:id="@+id/pB" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="--"
                        android:textColor="@color/text" android:textSize="22sp" android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <TextView android:id="@+id/time"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:textColor="#7D786B" android:textSize="12sp" />
            <Button android:id="@+id/refresh" style="@style/GoldBtn" android:text="تحديث الآن" />
        </LinearLayout>

        <!-- portfolio -->
        <LinearLayout style="@style/Card">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="💰 مشترياتي" android:textColor="@color/text"
                android:textSize="18sp" android:textStyle="bold" />
            <TextView style="@style/Label" android:layout_marginTop="4dp" android:textSize="11sp"
                android:text="ذهب عيار 24 — الربح محسوب على سعر البيع للبنك الحين" />

            <LinearLayout android:id="@+id/pfSummary"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:orientation="vertical"
                android:background="@drawable/input_bg" android:padding="14dp"
                android:visibility="gone">
                <TextView style="@style/Label" android:text="لو بعت الحين" android:textSize="12sp" />
                <TextView android:id="@+id/pfProfit" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:textSize="30sp" android:textStyle="bold"
                    android:textColor="@color/gold_light" />
                <TextView android:id="@+id/pfPct" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:textSize="13sp" android:textStyle="bold" />
                <TextView android:id="@+id/pfDetails" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:layout_marginTop="10dp"
                    android:textColor="@color/text" android:textSize="13sp" android:lineSpacingExtra="5dp" />
            </LinearLayout>

            <LinearLayout android:id="@+id/pfList"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:orientation="vertical" />

            <TextView style="@style/Label" android:layout_marginTop="14dp" android:text="إضافة عملية شراء" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal">
                <EditText android:id="@+id/pfGrams" style="@style/Input" android:layout_width="0dp"
                    android:layout_weight="1" android:layout_marginEnd="6dp" android:hint="الجرامات" />
                <EditText android:id="@+id/pfPrice" style="@style/Input" android:layout_width="0dp"
                    android:layout_weight="1" android:layout_marginStart="6dp" android:hint="سعر الجرام" />
            </LinearLayout>
            <Button android:id="@+id/pfDate" style="@style/GhostBtn" android:text="📅 اليوم" />
            <Button android:id="@+id/pfAdd" style="@style/GoldBtn" android:text="➕ إضافة" />
        </LinearLayout>

        <!-- chart -->
        <LinearLayout style="@style/Card">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="📈 حركة السعر" android:textColor="@color/text"
                android:textSize="18sp" android:textStyle="bold" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="10dp" android:orientation="horizontal">
                <TextView android:id="@+id/tDay" android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="34dp" android:layout_marginStart="3dp" android:layout_marginEnd="3dp"
                    android:gravity="center" android:text="اليوم" android:textColor="@color/text"
                    android:textSize="13sp" android:background="@drawable/tab_bg" />
                <TextView android:id="@+id/tWeek" android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="34dp" android:layout_marginStart="3dp" android:layout_marginEnd="3dp"
                    android:gravity="center" android:text="أسبوع" android:textColor="@color/text"
                    android:textSize="13sp" android:background="@drawable/tab_bg" />
                <TextView android:id="@+id/tMonth" android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="34dp" android:layout_marginStart="3dp" android:layout_marginEnd="3dp"
                    android:gravity="center" android:text="شهر" android:textColor="@color/text"
                    android:textSize="13sp" android:background="@drawable/tab_bg" />
                <TextView android:id="@+id/tYear" android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="34dp" android:layout_marginStart="3dp" android:layout_marginEnd="3dp"
                    android:gravity="center" android:text="سنة" android:textColor="@color/text"
                    android:textSize="13sp" android:background="@drawable/tab_bg" />
            </LinearLayout>
            <com.assiss.goldwatch.ChartView android:id="@+id/chart"
                android:layout_width="match_parent" android:layout_height="210dp"
                android:layout_marginTop="10dp" android:layoutDirection="ltr" />
            <TextView android:id="@+id/chartInfo" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_marginTop="6dp"
                android:textColor="@color/muted" android:textSize="13sp" />
            <TextView style="@style/Label" android:layout_marginTop="2dp" android:textSize="11sp"
                android:text="الخط الأحمر = سعر البيع للبنك • الأخضر = سعر الشراء من البنك. اسحب إصبعك على الرسم لعرض السعرين في أي نقطة." />
        </LinearLayout>

        <!-- alerts -->
        <LinearLayout style="@style/Card">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="🔔 التنبيهات" android:textColor="@color/text"
                android:textSize="18sp" android:textStyle="bold" />
            <TextView style="@style/Label" android:layout_marginTop="10dp" android:text="العيار (يظهر كبير في التطبيق والودجت)" />
            <RadioGroup android:id="@+id/karats"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal">
                <RadioButton android:id="@+id/k24" android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content" android:text="24" android:textColor="@color/text"
                    android:buttonTint="@color/gold" />
                <RadioButton android:id="@+id/k21" android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content" android:text="21" android:textColor="@color/text"
                    android:buttonTint="@color/gold" />
                <RadioButton android:id="@+id/k18" android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content" android:text="18" android:textColor="@color/text"
                    android:buttonTint="@color/gold" />
            </RadioGroup>

            <TextView style="@style/Label" android:layout_marginTop="10dp"
                android:text="▲ للبيع: نبهني إذا سعر البيع للبنك ارتفع فوق" />
            <EditText android:id="@+id/up" style="@style/Input" android:hint="مثال: 390" />

            <TextView style="@style/Label" android:layout_marginTop="12dp"
                android:text="▼ للشراء: نبهني إذا سعر الشراء من البنك نزل تحت" />
            <EditText android:id="@+id/low" style="@style/Input" android:hint="مثال: 370" />

            <Button android:id="@+id/save" style="@style/GoldBtn" android:text="حفظ التنبيه" />
            <Button android:id="@+id/clear" style="@style/GhostBtn" android:text="إلغاء التنبيهات" />
            <Button android:id="@+id/testAlert" style="@style/GhostBtn" android:text="🔔 جرّب التنبيه" />
            <TextView android:id="@+id/alertStatus"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:textColor="@color/gold_light"
                android:textSize="14sp" android:lineSpacingExtra="4dp" />
        </LinearLayout>

        <!-- bank margin -->
        <LinearLayout style="@style/Card">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="🏦 سعر البنك" android:textColor="@color/text"
                android:textSize="18sp" android:textStyle="bold" />
            <TextView style="@style/Label" android:layout_marginTop="8dp" android:lineSpacingExtra="3dp"
                android:text="اكتب فرق البنك عن السعر العالمي (٪)، وتطلع لك أسعار البيع والشراء جنب السعر العالمي. تنبيه البيع يمشي على سعر البيع، وتنبيه الشراء على سعر الشراء. خلها 0 للسعر العالمي بس." />
            <RadioGroup android:id="@+id/marginMode"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:orientation="horizontal">
                <RadioButton android:id="@+id/modeSell" android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content" android:text="الرقم الكبير: البيع"
                    android:textColor="@color/text" android:buttonTint="@color/gold" />
                <RadioButton android:id="@+id/modeBuy" android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content" android:text="الرقم الكبير: الشراء"
                    android:textColor="@color/text" android:buttonTint="@color/gold" />
            </RadioGroup>
            <EditText android:id="@+id/margin" style="@style/Input" android:hint="فرق البنك ٪ — الأهلي تقريباً 1" />
            <Button android:id="@+id/saveMargin" style="@style/GoldBtn" android:text="حفظ" />
        </LinearLayout>

        <!-- setup -->
        <LinearLayout style="@style/Card">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="الإعداد" android:textColor="@color/text"
                android:textSize="18sp" android:textStyle="bold" />
            <Button android:id="@+id/addWidget" style="@style/GoldBtn" android:text="أضف الودجت للشاشة" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="16dp" android:orientation="horizontal">
                <TextView style="@style/Label" android:layout_width="0dp" android:layout_weight="1"
                    android:text="شفافية خلفية الودجت" />
                <TextView android:id="@+id/alphaValue" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:textColor="@color/gold_light"
                    android:textSize="13sp" android:textStyle="bold" />
            </LinearLayout>
            <SeekBar android:id="@+id/alphaBar" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="6dp"
                android:max="100" android:progressTint="@color/gold"
                android:thumbTint="@color/gold_light" android:progressBackgroundTint="#55D4AF37" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView style="@style/Label" android:layout_width="0dp" android:layout_weight="1"
                    android:textSize="11sp" android:text="معتم" />
                <TextView style="@style/Label" android:textSize="11sp" android:text="شفاف" />
            </LinearLayout>
            <Button android:id="@+id/battery" style="@style/GhostBtn" android:text="استثناء التطبيق من توفير البطارية" />
            <TextView style="@style/Label" android:layout_marginTop="12dp" android:lineSpacingExtra="4dp"
                android:text="• السعر يتحدث تلقائياً كل 15 دقيقة تقريباً (أقل مدة يسمح فيها أندرويد).\n• الأسعار عالمية محوّلة للريال على سعر 3.75، وقد تختلف عن أسعار المحلات بسبب المصنعية والضريبة.\n• استثناء التطبيق من توفير البطارية يضمن وصول التنبيهات في وقتها." />
        </LinearLayout>

        <!-- signature -->
        <View
            android:layout_width="48dp"
            android:layout_height="2dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="28dp"
            android:background="@color/gold" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:text="تصميم وتطوير"
            android:textColor="@color/muted"
            android:textSize="12sp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="2dp"
            android:text="مسفر القحطاني"
            android:textColor="@color/gold"
            android:textSize="18sp"
            android:textStyle="bold"
            android:letterSpacing="0.05" />
        <TextView
            android:id="@+id/version"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp"
            android:textColor="#5E5A4F"
            android:textSize="11sp" />
    </LinearLayout>
</ScrollView>
